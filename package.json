{
  "name": "zzz-workbench",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "test:governance": "node --test scripts/governance/*.node.mjs scripts/github-app/*.node.mjs",
    "test:visual": "playwright test",
    "test:visual:server": "npm run build && npm run preview",
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "check": "npm run test:governance && vitest run && tsc -b && vite build",
    "test:watch": "vitest"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "rolldown": "1.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
