{
  "manifest_version": 3,
  "name": "ZZZ Setup Companion",
  "version": "0.4.1",
  "description": "선택한 파티의 HoYoLAB 장비를 읽어 현재 ZZZ Setup Workbench 설정으로 변환합니다.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ZZZ Setup Companion"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; img-src 'self'; style-src 'self'"
  }
}
